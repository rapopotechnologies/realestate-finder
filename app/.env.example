# Copy to app/.env.local and fill in. Never commit real keys.
# Supabase → Project Settings → API keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Map tiles: MapTiler free-tier key. Leave empty to use OpenFreeMap (no key needed).
NEXT_PUBLIC_MAPTILER_KEY=
# Server only: Street View / satellite images for tax deed properties (never sent to the browser)
GOOGLE_MAPS_API_KEY=
# Monthly cap on Google image requests made by the app (default 10000)
GOOGLE_MAPS_MONTHLY_LIMIT=10000
# Server only, optional: skip-trace provider for "Find contact info" (off when empty)
SKIP_TRACE_PROVIDER=
SKIP_TRACE_API_KEY=
